# Environment configuration for Wheels
# Never commit this file to version control.

# Set WHEELS_ENV to explicitly override environment (e.g. development, production, testing).
# If commented out, Wheels automatically sets "development" on localhost/127.0.0.1 and "production" on a live domain.
# WHEELS_ENV=development

WHEELS_DATASOURCE=wheels
WHEELS_RELOAD_PASSWORD=
WHEELS_LUCEE_ADMIN_PASSWORD=

# Optional: Fixed base URL (e.g. https://yourdomain.com). Leave commented to auto-detect from request.
# WHEELS_BASE_URL=
